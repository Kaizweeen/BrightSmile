{
  "name": "brightsmile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3600",
    "build": "next build",
    "start": "next start -p 3600",
    "lint": "eslint",
    "test": "vitest run tests/unit",
